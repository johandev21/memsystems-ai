# Copy this file to .env.docker.prod before running pnpm docker:prod.
# APP_ORIGIN is the exact browser-facing origin (no trailing slash). Keep it in
# sync with APP_PORT for local use, or replace it with the deployed HTTPS origin.
APP_PORT=3000
APP_ORIGIN=http://localhost:3000

POSTGRES_USER=postgres
# Generate a URL-safe password with the command below; arbitrary punctuation can
# break the DATABASE_URL assembled by Compose.
POSTGRES_PASSWORD=
POSTGRES_DB=memsystems

# Run this command separately for POSTGRES_PASSWORD and each secret:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# The two secrets must be independent random values of at least 32 characters.
BETTER_AUTH_SECRET=
DEV_STORAGE_TOKEN_SECRET=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
