# Server Configuration
PORT=4000
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL + Drizzle ORM)
DATABASE_URL=postgresql://postgres:superuser@localhost:5432/memsystems

# Authentication (Better Auth)
# Generate a secret using: openssl rand -hex 32
BETTER_AUTH_SECRET=byFdrOdUuBegiR3NAVfq8tKp93SRk3VS
BETTER_AUTH_URL=http://localhost:3000

# Social Auth Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Features (Optional - users can also provide their own key in the UI)
OPENAI_API_KEY=

# Local Storage Configuration (Default in Dev Mode)
DEV_STORAGE_DIR=./dev-storage
DEV_STORAGE_PUBLIC_URL=http://localhost:4000
DEV_STORAGE_TOKEN_SECRET=dev_secret_change_me_in_prod

# S3 Storage Configuration (Optional - if S3_ENDPOINT is set, S3/R2/MinIO will be used instead of local disk)
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=memsystems-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true
