# =============================================================================
# memsystems backend — environment variables
# Copy this file to `.env` and fill in the values. Do not commit `.env`.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string. Used by Drizzle and Better Auth.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memsystems_db

# --- Auth (Better Auth) ------------------------------------------------------
# 32+ random bytes, base64. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of the backend. Used for callbacks and CORS origin checks.
BETTER_AUTH_URL=http://localhost:4000

# --- Google OAuth (Better Auth social provider) ------------------------------
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI Providers (used by the Study Assistant) -------------------------------
# Platform fallback for OpenAI. Add others later (Anthropic, Google, etc.).
OPENAI_API_KEY=

# --- File storage -------------------------------------------------------------
# Production: S3-compatible object storage (Cloudflare R2, MinIO, AWS S3, ...).
# Leave S3_ENDPOINT empty in development to use the local filesystem fallback,
# which writes to ./dev-storage and serves via /__dev-storage/* with short-lived
# HMAC-signed URLs.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to "true" for MinIO. Cloudflare R2 and AWS S3 use virtual-hosted style (default false).
S3_FORCE_PATH_STYLE=false

# --- Local dev storage (only used when S3_ENDPOINT is empty) ------------------
# Where uploaded files are written on disk. Defaults to ./dev-storage.
DEV_STORAGE_DIR=
# HMAC secret for signing dev presigned URLs. If empty, a random secret is
# generated at process start (fine for solo dev; set explicitly if you want
# URLs to survive a restart).
DEV_STORAGE_TOKEN_SECRET=
# Public base URL embedded in dev presigned URLs. Defaults to http://localhost:4000.
DEV_STORAGE_PUBLIC_URL=
